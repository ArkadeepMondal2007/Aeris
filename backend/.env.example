# All values are optional. The defaults below are what the app uses if a line is missing.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Delivery dates analysed (Europe/London dates, inclusive)
ANALYSIS_START=2026-01-01
ANALYSIS_END=2026-01-31

# ASSUMPTION: the brief does not name a decision hour.
# Forecasts must be published at or before this local time, this many days before delivery.
DECISION_CUTOFF_TIME=17:00
DECISION_DAYS_AHEAD=1
TIMEZONE=Europe/London

# Verified from live data: WINDFOR start times are all on the hour.
FORECAST_INTERVAL_MINUTES=60
FORECAST_LOOKBACK_DAYS=5

REQUEST_TIMEOUT_SECONDS=60
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173
